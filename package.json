{
  "name": "printhive-api-example",
  "version": "1.0.0",
  "description": "Slice a project 3MF in the cloud and follow a Print Hive job",
  "scripts": {
    "start": "node src/server.mjs",
    "send-print": "node src/cli.mjs",
    "test": "node --test test/*.test.mjs",
    "proof": "node proof/run.mjs",
    "sdk:local": "node scripts/use-local-sdk.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "check-types": "tsc --noEmit",
    "test:ui": "vitest run",
    "verify": "npm run build && npm test && npm run test:ui"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@printhive/api": "0.3.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "6.0.0",
    "tw-animate-css": "^1.4.0",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^26.1.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
